{
  "name": "xueli-wordspell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Touch-first English storybook adventure; initialization baseline.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:domain": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution Bundler src/domain/world.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "6.0.2",
    "vite": "8.3.0"
  }
}
